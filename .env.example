# radiology-reporting-harness environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini API (required when running the inference pipeline) ---
GEMINI_API_KEY=your_api_key_here
# 2.5+ model required for the strict JSON response_json_schema output mode.
GEMINI_MODEL=gemini-2.5-flash
# Sampling temperature for the edit step (low = conservative, deterministic).
GEMINI_TEMPERATURE=0.2
# Maximum output tokens per request (the structured edit payload is small).
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Pipeline runtime ---
# Seconds to sleep between normal (successful) Gemini requests.
REQUEST_DELAY_SECONDS=2
# Maximum number of attempts for a single case (including the first attempt).
MAX_RETRIES=3
# Base seconds for exponential backoff between retries: delay = BASE * 2 ** attempt
RETRY_BACKOFF_BASE_SECONDS=2